{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/esm",
    "declarationDir": "dist/types",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "tests"]
}
