    },
    "./nuxt": {
      "types": "./src/nuxt/module.ts",
      "import": "./src/nuxt/module.ts"
    }
  },
  "devDependencies": {
    "@nuxt/schema": "^4.5.2",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  }
}
